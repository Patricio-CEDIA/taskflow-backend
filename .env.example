APP_NAME=TaskFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taskflow
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Nota (Sesión 7): esta variable solo aplica a autenticación por cookie de
# Sanctum. TaskFlow autentica por token Bearer (ver Sesión 5), así que no
# hace falta agregar aquí el dominio de GitHub Pages del frontend desplegado.

# --- Producción (Sesión 7 — Railway/Render) ---
# Descomenta y completa estas 3 al desplegar; en desarrollo local no aplican.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL={{REEMPLAZAR: URL pública que te da Railway/Render}}
